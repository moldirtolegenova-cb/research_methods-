# Python cache
__pycache__/
*.py[cod]
*.pyo

# Virtual environments
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# IDE
.vscode/
.idea/

# Operating system
.DS_Store
Thumbs.db
desktop.ini

# Temporary files
*.tmp
*.log
*.bak
*.swp

# Python build files
build/
dist/
*.egg-info/

# Large raw datasets
# Keep the required benchmark sample.
data/raw/*
!data/raw/test_run.jsonl
!data/raw/.gitkeep

# Generated model files
*.pkl
*.joblib

# Keep processed results
!data/processed/
!data/processed/*.csv

# Keep benchmark results
!results/
!results/*.csv

# Keep scientific figures
!reports/
!reports/figures/
!reports/figures/*.pdf
!reports/figures/*.png